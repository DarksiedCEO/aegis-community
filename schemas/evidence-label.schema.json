{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-community.example/schemas/evidence-label.schema.json",
  "title": "AEGIS evidence and truth label",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "role_id",
    "subject",
    "claim",
    "evidence_level",
    "truth_label",
    "producer",
    "observed_at",
    "gaps"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "role_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "subject": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "evidence_level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "truth_label": {
      "enum": ["ASSERTED", "OBSERVED", "REPRODUCED", "INDEPENDENTLY_REPRODUCED", "ATTESTED", "UNVERIFIED"]
    },
    "producer": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "gaps": {"type": "array", "items": {"type": "string"}}
  }
}
